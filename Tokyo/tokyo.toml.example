# Copy to tokyo.toml and change what you need. Defaults are in tokyo/config.py
# (pins as in the DRIFTS Rev 9 wiring sheet, with the fixes in Docs/wiring.md).
[motors]
duty = 1.0            # 4 motor modules with onboard driver, all IN pins on GPIO 13

[buzzer]
kind = "active"       # 3 V magnetic active buzzer on GPIO 18 (on/off only)

[strip]
backend = "spi"       # pi5neo on GPIO 10; "pio" + pin = N for another GPIO
count = 14
brightness = 0.25

[ir]
mode = "auto"         # on when the camera sees night; "on" / "off"
duty = 1.0

[voice]
enabled = true
device = ""           # e.g. "plughw:CARD=Device" (aplay -l) for the USB audio adapter
